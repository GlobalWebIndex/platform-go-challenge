{
    "id": null,
    "uid": "api-overview",
    "title": "API Overview",
    "schemaVersion": 39,
    "version": 1,
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 0,
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m"
      ]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "type": "dashboard",
          "name": "Annotations & Alerts",
          "hide": false,
          "iconColor": "rgba(0, 211, 255, 1)",
          "enable": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Requests per Second by Endpoint & Status",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["last"]
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(10, sum by (endpoint, status) (rate(http_requests_total[1m])))",
            "legendFormat": "{{endpoint}} ({{status}})"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "p95 Latency by Endpoint",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 20
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["last"]
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(http_request_duration_seconds_bucket[5m])))",
            "legendFormat": "{{endpoint}} p95"
          }
        ]
      },
      {
        "id": 3,
        "type": "table",
        "title": "Request Volume by Endpoint & Status (last 5m)",
        "datasource": "Prometheus",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true
        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (endpoint, status) (rate(http_requests_total[5m]))"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "indexByName": {
                "endpoint": 0,
                "status": 1,
                "Value": 2
              },
              "renameByName": {
                "Value": "req/s"
              }
            }
          }
        ]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Global Error Rate (4xx+5xx, last 5m)",
        "datasource": "Prometheus",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": ["last"],
            "fields": "",
            "values": false
          },
          "orientation": "horizontal",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 * sum(increase(http_requests_total{status=~\"4..|5..\"}[5m])) / sum(increase(http_requests_total[5m]))",
            "legendFormat": "error rate"
          }
        ]
      }
    ]
  }
  